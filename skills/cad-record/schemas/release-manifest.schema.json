{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srobroek.com/cad/schemas/release-manifest.schema.json",
  "title": "CAD release manifest",
  "description": "Version 1 (no schema_version) lists project files in place. Version 2, written by release.py, seals a package of byte copies under hw/releases/<rev>/. Version 3 adds the record version 2 acceptance anchor: the frozen evidence digest, its inventory, the release scope, claims and waivers. Sealed packages are read by their own version and never rewritten or re-certified.",
  "if": {"type": "object", "required": ["schema_version"]},
  "then": {"if": {"properties": {"schema_version": {"const": 3}}}, "then": {"$ref": "#/$defs/v3"}, "else": {"$ref": "#/$defs/v2"}},
  "else": {"$ref": "#/$defs/v1"},
  "$defs": {
    "product_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "rev": {"type": "string", "pattern": "^[A-HJ-NPRTUVWY]$"},
    "checks": {"type": "object", "additionalProperties": {"type": "string", "enum": ["pass", "fail", "waived"]}},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "package_path": {
      "description": "A path inside the package directory",
      "type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.{1,2}(/|$))(?!manifest\\.json$)[^\\\\]+$"
    },
    "v1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "rev", "released_at", "files", "checks"],
      "properties": {
        "product_id": {"$ref": "#/$defs/product_id"},
        "rev": {"$ref": "#/$defs/rev"},
        "released_at": {"type": "string", "format": "date-time"},
        "files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "checks": {"$ref": "#/$defs/checks"}
      }
    },
    "v2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "product_id", "rev", "released_at", "frozen", "approval", "files", "manufacturing", "bundles", "checks"],
      "properties": {
        "schema_version": {"const": 2},
        "product_id": {"$ref": "#/$defs/product_id"},
        "rev": {"$ref": "#/$defs/rev"},
        "released_at": {"type": "string", "format": "date-time"},
        "frozen": {"$ref": "product.schema.json#/$defs/frozen"},
        "approval": {"description": "the decision record approving this release", "$ref": "product.schema.json#/$defs/decision"},
        "files": {
          "description": "Every package file but manifest.json, keyed by its path in the package, with its sha256 and the immutable original it copies",
          "type": "object", "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/package_path"},
          "additionalProperties": {
            "type": "object", "additionalProperties": false, "required": ["sha256", "original"],
            "properties": {
              "sha256": {"$ref": "#/$defs/sha256"},
              "original": {"type": "string", "pattern": "^hw/(?!releases/)(?!.*(^|/)\\.{1,2}(/|$))[^\\\\]+$"}
            }
          }
        },
        "manufacturing": {
          "description": "Per custom-made PN of the frozen version: its process, assembled quantity and package files",
          "type": "object",
          "propertyNames": {"pattern": "^[A-Z]{2,5}-[0-9]{4}$"},
          "additionalProperties": {
            "type": "object", "additionalProperties": false, "required": ["process", "quantity", "files"],
            "properties": {
              "process": {"$ref": "manufacturing.schema.json#/$defs/primary_process"},
              "quantity": {"type": "integer", "minimum": 1},
              "files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/package_path"}}
            }
          }
        },
        "bundles": {
          "description": "The drawing, check, analysis and other bundles the release selected, by manifest sha256",
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["layout", "path", "manifest_sha256"],
            "properties": {
              "layout": {"type": "string", "pattern": "^[a-z]+(\\.[a-z_]+)*$"},
              "path": {"type": "string", "pattern": "^hw/(?!.*(^|/)\\.{1,2}(/|$))[^\\\\]+$"},
              "manifest_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "checks": {"$ref": "#/$defs/checks"}
      }
    },
    "v3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_version", "product_id", "rev", "released_at", "frozen", "approval", "files",
                   "manufacturing", "bundles", "checks", "acceptance"],
      "properties": {
        "schema_version": {"const": 3},
        "record_version": {"$ref": "manufacturing.schema.json#/$defs/record_version"},
        "product_id": {"$ref": "#/$defs/product_id"},
        "rev": {"$ref": "#/$defs/rev"},
        "released_at": {"type": "string", "format": "date-time"},
        "frozen": {"allOf": [{"$ref": "product.schema.json#/$defs/frozen"}, {"required": ["evidence_sha256"]}]},
        "approval": {"description": "the decision record approving this release", "$ref": "product.schema.json#/$defs/decision"},
        "files": {"$ref": "#/$defs/v2/properties/files"},
        "manufacturing": {
          "description": "Per custom-made PN of the frozen version: its process, assembled quantity, package files, the route kinds it was assessed for and its per-component files",
          "type": "object",
          "propertyNames": {"pattern": "^[A-Z]{2,5}-[0-9]{4}$"},
          "additionalProperties": {
            "type": "object", "additionalProperties": false, "required": ["process", "quantity", "files", "route"],
            "properties": {
              "process": {"$ref": "manufacturing.schema.json#/$defs/primary_process"},
              "quantity": {"type": "integer", "minimum": 1},
              "files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/package_path"}},
              "route": {"type": "array", "minItems": 1, "items": {"$ref": "manufacturing.schema.json#/$defs/route_kind"}},
              "components": {
                "type": "object", "minProperties": 1,
                "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
                "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/package_path"}}
              }
            }
          }
        },
        "bundles": {"$ref": "#/$defs/v2/properties/bundles"},
        "checks": {"$ref": "#/$defs/checks"},
        "acceptance": {
          "description": "What the release is accepted for, sealed from its own package bytes: the canonical acceptance inventory and its digest (equal to frozen.evidence_sha256), the release scope, the evidence levels claimed per requirement, the approved waivers and any obligations left open within a permitted trial scope. Unknown is never a pass, and a waiver stays waived",
          "type": "object", "additionalProperties": false, "required": ["evidence_sha256", "inventory", "scope", "claims", "waivers", "open_obligations"],
          "properties": {
            "evidence_sha256": {"$ref": "#/$defs/sha256"},
            "inventory": {
              "description": "hw-relative path to sha256 of every file the digest covers",
              "type": "object", "minProperties": 1,
              "propertyNames": {"pattern": "^hw/(?!releases/)(?!(.*/)?\\.{1,2}(/|$))[^\\\\]+$"},
              "additionalProperties": {"$ref": "#/$defs/sha256"}
            },
            "scope": {
              "type": "object", "additionalProperties": false, "required": ["service_class", "purpose", "operating_limits", "exclusions", "trial"],
              "properties": {
                "service_class": {"enum": ["appearance_concept", "fit_assembly", "functional_demo", "working_prototype", "production", "safety_critical"]},
                "purpose": {"$ref": "manufacturing.schema.json#/$defs/text"},
                "operating_limits": {"type": "array", "items": {"$ref": "manufacturing.schema.json#/$defs/text"}},
                "exclusions": {"type": "array", "items": {"$ref": "manufacturing.schema.json#/$defs/text"}},
                "trial": {"description": "true for an explicitly unvalidated trial release", "type": "boolean"}
              }
            },
            "claims": {
              "description": "The evidence levels the release claims, per requirement",
              "type": "object",
              "propertyNames": {"pattern": "^REQ-[0-9]{3}$"},
              "additionalProperties": {"type": "array", "uniqueItems": true, "items": {"$ref": "manufacturing.schema.json#/$defs/evidence_level"}}
            },
            "waivers": {"type": "array", "items": {"$ref": "manufacturing.schema.json#/$defs/waiver"}},
            "open_obligations": {"type": "array", "uniqueItems": true, "items": {"$ref": "manufacturing.schema.json#/$defs/obligation_id"}}
          }
        }
      }
    }
  }
}
